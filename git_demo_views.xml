<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_git_demo_list" model="ir.ui.view">
        <field name="name">git.demo.list</field>
        <field name="model">git.demo</field>
        <field name="arch" type="xml">
            <list string="Git Demo">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_git_demo_form" model="ir.ui.view">
        <field name="name">git.demo.form</field>
        <field name="model">git.demo</field>
        <field name="arch" type="xml">
            <form string="Git Demo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_git_demo" model="ir.actions.act_window">
        <field name="name">Git Demo</field>
        <field name="res_model">git.demo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_git_demo_root" name="Git Demo"/>
    <menuitem id="menu_git_demo_records"
              name="Demo Records"
              parent="menu_git_demo_root"
              action="action_git_demo"/>
</odoo>
